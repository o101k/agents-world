{
  "name": "agents-world",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based 2D life simulation where every human is an independent AI agent.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/agentic"
  ],
  "scripts": {
    "start": "turbo run build --filter=@aw/web && npm run start -w @aw/server",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run build --filter=@aw/web && playwright test",
    "test:agentic": "turbo run build --filter=@aw/web && npm run test -w @aw/agentic-tests --",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "turbo run typecheck lint test",
    "stress": "npm run stress -w @aw/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": false
  }
}
