{
  "name": "agents-world",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based 2D life simulation where every human is an independent AI agent.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run build -w @aw/web && npm run start -w @aw/server",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @aw/server\" \"npm run dev -w @aw/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build -w @aw/web && playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "stress": "npm run stress -w @aw/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": false
  }
}
